# Copy to terraform.tfvars and edit. Do not put the API token in here -- use
#   export LAUNCHDARKLY_ACCESS_TOKEN=api-xxxxxxxx

units = {
  "brand-x" = {
    name = "Brand X"

    # "role_attribute" (the default) confines each team to its own project and is
    # the mode the deny guard exists for. Switch to "namespace" only if
    # tests/boundary-tests.sh section 9 reports that roles resolve to 0 projects,
    # which means role attributes are not taking effect in your account.
    # scoping_mode = "namespace"

    # Leave false unless you want the unit's own pipeline to be able to delete
    # its projects and teams. Terraform will attempt deletion whenever a resource
    # block is removed, so this is the difference between a bad merge being an
    # inconvenience and it being an incident.
    allow_destructive_actions = false

    # Turn on to let the unit mint its own downstream pipeline tokens. Safe with
    # respect to the namespace -- a token cannot exceed its creator -- but it is a
    # rotation commitment, since token permissions are fixed at creation.
    allow_token_minting = false
  }

  "brand-y" = {
    name = "Brand Y"
  }
}

acting_unit_key = "brand-x"
other_unit_key  = "brand-y"

create_admin_teams         = true
create_unit_service_tokens = true

# Projects for the OTHER unit -- the control the isolation tests assert against.
# Several rather than one, so "GET /projects returns only my own" has a realistic
# amount to be invisible.
other_unit_projects = {
  payments   = { name = "Payments" }
  fulfilment = { name = "Fulfilment" }
  loyalty    = { name = "Loyalty" }
}

# Which of those the test suite pins as its primary unreachable target.
isolation_target = "payments"
