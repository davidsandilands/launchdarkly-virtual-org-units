# Copy to terraform.tfvars and edit.
#
# Apply this with the UNIT's delegated token, not an org admin token:
#   export LAUNCHDARKLY_ACCESS_TOKEN=$LD_UNIT_TOKEN

unit_key  = "brand-x"
unit_name = "Brand X"

# Supplies the project as a role attribute when attaching catalogue roles, which is
# what confines each team to its own project. Must match the catalogue's
# scoping_mode. Set false if the catalogue uses "namespace".
# set_role_attributes = true

# Each entry becomes a project, two environments, a leads team and a developers
# team, with catalogue roles attached. Adding one is the entire onboarding process:
# no platform-team ticket, no new role authored.
products = {
  "checkout" = {
    name = "Checkout"
    tags = ["owner-brand-x", "managed-by-unit"]

    # Emails of EXISTING account members, who must have base role no_access.
    # Leave empty if an identity provider owns team membership -- only one system
    # should be the authority, or Terraform and SCIM will overwrite each other on
    # every apply.
    lead_member_emails      = []
    developer_member_emails = []
  }

  "search" = {
    name = "Search"
    tags = ["owner-brand-x", "managed-by-unit"]
  }

  "mobile" = {
    name = "Mobile app"
    tags = ["owner-brand-x", "managed-by-unit"]
  }
}
